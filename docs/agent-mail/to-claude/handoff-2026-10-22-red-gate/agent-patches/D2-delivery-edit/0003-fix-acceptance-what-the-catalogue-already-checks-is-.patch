@@ -79,6 +79,32 @@ describe('the criteria come from HIS brief, never from a fixed checklist', () =>
         ].sort());
     });
 
+    /**
+     *  ⛔ WHAT THE CATALOGUE ALREADY CHECKS IS NOT A COLUMN AS WELL.
+     *
+     *  «a counter, title, and production build» was read twice: as the three
+     *  catalogue criteria, and again as three table columns no page can ever
+     *  have — six criteria, three of them unmeetable. The widget guard kept a
+     *  list of its own (counter, title…) that did not know `production build`
+     *  and did not know the Arabic article. One reader decides now.
+     */
+    it('⛔ NEGATIVE — a page of catalogue shapes asks for no table column', () => {
+        expect(acceptanceFor('Create a page with a counter, title, and production build.').map(c => c.id))
+            .toEqual(['counter', 'title', 'production_build']);
+    });
+
+    it('⛔ NEGATIVE — «العداد والعنوان والزر» with the article are the same widgets', () => {
+        expect(acceptanceFor('ابن لي تطبيق فيه العداد والعنوان والزر').map(c => c.id)
+            .filter(id => id.startsWith('column:'))).toEqual([]);
+    });
+
+    it('⛔ POSITIVE — one label the catalogue does not check keeps the whole list as columns', () => {
+        //  «title» alone is a catalogue shape; beside «author» and «rating» it
+        //  is a column of a reading tracker, and all three are kept.
+        expect(acceptanceFor('Build a tracker with title, author and rating')
+            .filter(c => c.expectedColumn).map(c => c.expectedColumn)).toEqual(['title', 'author', 'rating']);
+    });
+
     it('freezes the Gate062 acceptance input separately from the live input', () => {
         expect(acceptanceFor(GATE062_ACCEPTANCE_PROMPT).map(c => c.id).sort()).toEqual([
             'button', 'counter', 'status_message', 'title',
diff --git a/api/src/core/quality/acceptance.ts b/api/src/core/quality/acceptance.ts
index 386e02d1..03b30f1e 100644
--- a/api/src/core/quality/acceptance.ts
+++ b/api/src/core/quality/acceptance.ts
@@ -548,16 +548,33 @@ export function acceptanceFor(request: string): Criterion[] {
     const willBuildATable = detectedKind !== null;
     const derived = willBuildATable ? (columnsAnywhereInHisRequest(t) || []) : [];
     const explicitSchema = /\b(?:fields?|columns?|records?|table|form)\b|(?:حقول?|أعمدة|اعمدة|سجلات?|جدول|نموذج)/iu.test(t);
-    const uiOnlyLabel = (label: string) => /^(?:a\s+|an\s+|the\s+)?(?:counter|button|title|heading|status\s+message|عداد|زر|عنوان|رسالة\s+حالة)$/iu
-        .test(String(label || '').trim());
+    /**
+     *  ⛔ WHAT THE CATALOGUE ALREADY CHECKS IS NOT A COLUMN.
+     *
+     *  «Create a page with a counter, title, and production build.» derived
+     *  six criteria: the catalogue's three, and the same three words again as
+     *  «a column «production build» exists in the table» — criteria no page
+     *  can ever meet, so the delivery is refused for having no table.
+     *
+     *  The widget guard below held its own list of UI words (counter, button,
+     *  title, heading, status message). The catalogue above is a second list
+     *  answering the same question, and it also checks `production build`,
+     *  `preview`, `export`… The two drifted the moment a request named
+     *  something only one of them knew. So there is one reader now: a derived
+     *  label that, read on its own, raises a catalogue criterion THIS request
+     *  already carries is that criterion — never a column as well.
+     */
+    const catalogueIds = new Set(catalogue.map(c => c.id));
+    const checkedByCatalogue = (label: string) => CATALOGUE.some(c => catalogueIds.has(c.id)
+        && (c.says ? saysAny(String(label || ''), c.says) : requestAsksFor(c.asked, String(label || ''))));
     // A list of visible widgets is not a record schema. Without an explicit
     // table/form/field declaration, suppress a derived run made entirely of
-    // UI shapes that the acceptance catalogue already checks directly.
+    // shapes the acceptance catalogue already checks directly.
     // A natural-language field list need not literally say "fields" or "table".
     // Keep the separate widget-only guard below even when that list was parsed.
     const columns = !explicitSchema && !hasExplicitRecordSchema(t) && detectedKind === 'generic'
         ? []
-        : !explicitSchema && derived.length > 0 && derived.every(column => uiOnlyLabel(column.label))
+        : !explicitSchema && derived.length > 0 && derived.every(column => checkedByCatalogue(column.label))
         ? []
         : derived;
     const requestedFilters = willBuildATable ? requestedFilterFields(t, columns) : [];
