 });
+
+/**
+ *  …AND THE SAME CLAIM, RUN ON REAL PROCESSES — ONCE PER KIND OF LAUNCH.
+ *
+ *  The session's previous preview is a live child process, recorded the way
+ *  a real round records it, and project_run is asked for the next system.
+ *  A dependency-free records bundle used to be served BEFORE the retirement
+ *  line was reached: the previous preview kept running beside the new one,
+ *  and its record was overwritten by the new server's — an orphan that no
+ *  later round could find, which is the exact count this file began with.
+ */
+describe('the previous preview is retired on every launch path, measured', () => {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const { spawn } = require('child_process');
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const os = require('os');
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const http = require('http');
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const { ProjectRunTool } = require('../modules/tools/definitions/ProjectRunTool');
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const { executionFirewall } = require('../orchestration/AgentExecutionFirewall');
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const { writeJoeProject } = require('../api/page-store');
+
+    const freePort = async (): Promise<number> => {
+        const probe = http.createServer();
+        await new Promise<void>(resolve => probe.listen(0, '127.0.0.1', () => resolve()));
+        const port = Number(probe.address().port);
+        await new Promise<void>(resolve => probe.close(() => resolve()));
+        return port;
+    };
+
+    const nextRoundAfterALivePreview = async (label: string, writeNext: (dir: string) => void) => {
+        const root = fs.mkdtempSync(path.join(os.tmpdir(), `joe-retire-${label}-`));
+        const previous = path.join(root, 'previous-app');
+        const next = path.join(root, 'next-app');
+        fs.mkdirSync(previous, { recursive: true });
+        fs.mkdirSync(next, { recursive: true });
+        writeNext(next);
+        const old = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { cwd: previous, stdio: 'ignore' });
+        const gone = new Promise<string>(resolve => old.once('exit', () => resolve('exited')));
+        const sessionId = `retire-${label}-${process.pid}`;
+        writeJoeProject(sessionId, {
+            dir: previous, type: 'runtime',
+            live: { pid: old.pid, port: 1, url: 'http://127.0.0.1:1/', cwd: previous },
+        });
+        let result: any = null;
+        try {
+            const port = await freePort();
+            result = await executionFirewall.runInContext(`retire-${label}`, () =>
+                new ProjectRunTool().execute({ cwd: next, port }, { sessionId, workspaceRoot: root, workspaceId: `retire-${label}` }));
+            const previousPreview = await Promise.race([
+                gone,
+                new Promise<string>(resolve => setTimeout(() => resolve('still running'), 5000)),
+            ]);
+            return { result, previousPreview, oldPid: old.pid };
+        } finally {
+            try { old.kill('SIGKILL'); } catch { /* already gone */ }
+            const started = Number(result?.output?.pid || 0);
+            if (started > 0) { try { process.kill(started, 'SIGKILL'); } catch { /* already gone */ } }
+            delete (global as any).joeProjects?.[sessionId];
+            fs.rmSync(root, { recursive: true, force: true });
+        }
+    };
+
+    it('a dependency-free records bundle does not start beside the previous preview', async () => {
+        const { result, previousPreview, oldPid } = await nextRoundAfterALivePreview('records', dir => {
+            fs.writeFileSync(path.join(dir, 'package.json'), JSON.stringify({ name: 'next-app', private: true }));
+            fs.mkdirSync(path.join(dir, 'dist'), { recursive: true });
+            fs.writeFileSync(path.join(dir, 'dist', 'index.html'),
+                '<!doctype html><meta name="joe-artifact-mode" content="static-records"><title>records</title>');
+        });
+        expect(result.ok).toBe(true);
+        expect(result.output.kind).toBe('static-records');
+        expect(result.logs).toContain(`retired previous server pid=${oldPid} port=1`);
+        expect(previousPreview).toBe('exited');
+    }, 30_000);
+
+    it('…and neither does a managed server', async () => {
+        const { result, previousPreview, oldPid } = await nextRoundAfterALivePreview('managed', dir => {
+            fs.writeFileSync(path.join(dir, 'package.json'),
+                JSON.stringify({ name: 'next-app', private: true, scripts: { start: 'node server.js' } }));
+            fs.writeFileSync(path.join(dir, 'server.js'),
+                "require('http').createServer((_req, res) => res.end('next')).listen(Number(process.env.PORT), '127.0.0.1');\n");
+        });
+        expect(result.ok).toBe(true);
+        expect(result.output.kind).toBe('npm-start');
+        expect(result.logs).toContain(`retired previous server pid=${oldPid} port=1`);
+        expect(previousPreview).toBe('exited');
+    }, 60_000);
+});
