+++ b/api/src/__tests__/a-verb-phrase-read-as-a-column.test.ts
@@ -100,6 +100,14 @@ describe('a column is named by a noun, never by a verb', () => {
         expect(detectAppKind('عندي عيادة أسنان، أريد جدولاً فيه اسم المريض ورقم تلفونه ووقت الموعد')).toBe('generic');
     });
 
+    it('NEGATIVE — the «،» opens his request only through his verb: the same sentence without one is not promoted', () => {
+        //  The two tests above pass because «،» now ends the context clause
+        //  and «أريد» opens the request. The comma is not the request: take
+        //  the verb out of the very same sentence and the list stays a
+        //  description, which the planner contract refuses to build from.
+        expect(detectAppKind('عندي عيادة أسنان، جدولها فيه اسم المريض ورقم تلفونه ووقت الموعد')).not.toBe('generic');
+    });
+
     it('NEGATIVE — a noun that OPENS with a verb letter is still a column', () => {
         //  The case chosen to hurt: «يوم التسليم» opens with ي and is a
         //  noun. It stands here so no future widening of the behaviour-verb
diff --git a/api/src/core/design/app-blueprints.ts b/api/src/core/design/app-blueprints.ts
index 579491a2..de721295 100644
--- a/api/src/core/design/app-blueprints.ts
+++ b/api/src/core/design/app-blueprints.ts
@@ -3278,9 +3278,18 @@ export function hasExplicitRecordSchema(requestRaw: string): boolean {
     // camel farm. I want a register...". The build verb begins the second
     // sentence, not the whole message. Read a clause boundary, while still
     // refusing a mere description that never asks Joe to create anything.
+    //
+    // Arabic closes that context with «،» just as often: «عندي عيادة أسنان،
+    // أريد جدولاً فيه …» is the same two clauses, and a boundary read only at
+    // «.» left his request unread, so the clinic noun won the classifier and
+    // his three columns lost to a stock booking table. The Arabic words below
+    // are a first-person want or an imperative, so one standing after «،»
+    // opens his request. English keeps its sentence marks: there the comma
+    // separates list items, and «make» or «design» after it may be a column.
     const clauseStart = '(?:^|[.؟!\\n]\\s*)';
+    const arabicClauseStart = '(?:^|[.؟!\\n،]\\s*)';
     const isBuildRequest = new RegExp(`${clauseStart}(?:please\\s+)?(?:create|build|make|develop|design|scaffold|generate)\\b`, 'i').test(request)
-        || new RegExp(`${clauseStart}(?:بدي|أريد|اريد|أنشئ|انشئ|ابن|اصنع|صمم|طوّر|طور|اعمل)(?:\\s|$)`, 'iu').test(request);
+        || new RegExp(`${arabicClauseStart}(?:بدي|أريد|اريد|أنشئ|انشئ|ابن|اصنع|صمم|طوّر|طور|اعمل)(?:\\s|$)`, 'iu').test(request);
     if (!isBuildRequest) return false;
     const columns = columnsAnywhereInHisRequest(requestRaw);
     return Array.isArray(columns) && columns.length >= 2;
