@@ -3079,6 +3097,7 @@ export function derivedColumns(requestRaw: string): DerivedField[] | null {
         const opts = m[2].split(/\s*[،,\/|]\s*|\s+أو\s+|\s+او\s+|\s+or\s+/iu)
