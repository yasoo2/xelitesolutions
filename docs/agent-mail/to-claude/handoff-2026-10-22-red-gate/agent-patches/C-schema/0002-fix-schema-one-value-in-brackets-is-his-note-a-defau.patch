+function fieldsFromLabels(parts: string[], noted: ReadonlySet<string> = new Set()): DerivedField[] | null {
     const seen = new Map<DerivedRole, number>();
     const usedKeys = new Set<string>();
     const out: DerivedField[] = [];
@@ -3283,6 +3306,7 @@ function fieldsFromLabels(parts: string[]): DerivedField[] | null {
             type = 'select';
         } else {
