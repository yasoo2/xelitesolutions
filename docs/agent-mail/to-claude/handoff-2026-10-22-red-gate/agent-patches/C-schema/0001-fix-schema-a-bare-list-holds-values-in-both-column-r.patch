diff --git a/api/src/core/design/app-blueprints.ts b/api/src/core/design/app-blueprints.ts
index 74a91513..faecc61d 100644
--- a/api/src/core/design/app-blueprints.ts
+++ b/api/src/core/design/app-blueprints.ts
@@ -2679,6 +2679,30 @@ export function clausesBeyondTheColumns(requestRaw: string): string[] {
 const ENGLISH_INTRODUCES_A_LIST = /(?:^|[.!?]\s+|[\s,;:(])(?:(?:must|should)\s+(?:provide|include|have)|needs?|requires?|add|include(?:s|d)?|containing|consisting\s+of|made\s+up\s+of|with)(?=\s)/iu;
 const OPENS_WITH_AN_ARTICLE = /^(?:a|an|the)\s+/iu;
 
+/**
+ *  A LIST HOLDS VALUES. A TABLE HOLDS COLUMNS — ONE RULE, BOTH READERS.
+ *
+ *  Latin items carry no definiteness of their own, so the container they
+ *  hang from decides, and a bare «list» decides no: «a shopping list with
+ *  milk, bread and eggs» names three things, not three columns.
+ *
+ *  The rule was written once, inside the container reader, and lost twice:
+ *  the introducer reader was moved IN FRONT of that reader and never learned
+ *  it, and the container pattern lost its capture group, so the copy that
+ *  asked `holder[1]` asked an empty string and always answered «columns».
+ *  One function now, so neither reader can drift from the other.
+ */
+function aBareListHoldsValues(container: string | undefined, names: string[]): boolean {
+    return /^(?:list|قائمة)$/iu.test(String(container || '').trim())
+        && names.some(name => !/[؀-ۿ]/u.test(name));
+}
+
+/** The container an introducer hands its list to: the last one before it in the sentence. */
+function containerGoverning(prefix: string): string | undefined {
+    const found = Array.from(String(prefix || '').matchAll(new RegExp(RECORD_CONTAINER.source, 'giu')));
+    return found.length ? found[found.length - 1][0] : undefined;
+}
+
 /**
  * A long product brief can contain several English `with` clauses. The first
  * one may describe the page, while the list inside a form names the data the
@@ -2748,6 +2772,7 @@ function theListAnIntroducerHandedOver(request: string): DerivedField[] | null {
         if (run.length < (typedPair ? 2 : 3)) continue;
         const named = run.filter(isAName).filter(notAContainerItself);
         if (named.length !== run.length) continue;
+        if (aBareListHoldsValues(containerGoverning(containerPrefix), named)) continue;
         const built = fieldsFromLabels(named);
         if (built) return applyStatedRules(built, statedRules(request)).fields;
     }
@@ -2953,12 +2978,11 @@ export function derivedColumns(requestRaw: string): DerivedField[] | null {
          *  three attributes of each thing it holds. Reading the first as a
          *  schema would give him a two-row app about milk.
          */
-        const holdsColumns = !/^(?:list|قائمة)$/iu.test(holder[1] || '');
         const floor = holder ? 2 : 3;
         if (names.length < floor || names.length > 10) return null;
         //  Latin items carry no definiteness of their own, so the container
         //  they hang from decides — and a bare «list» decides no.
-        if (names.some(n => !/[؀-ۿ]/u.test(n)) && !holdsColumns) return null;
+        if (aBareListHoldsValues(holder[0], names)) return null;
         if (!everyItemIsADefiniteName(names)) return null;
         //  THE LINK THAT WAS NEVER JOINED.
         //
