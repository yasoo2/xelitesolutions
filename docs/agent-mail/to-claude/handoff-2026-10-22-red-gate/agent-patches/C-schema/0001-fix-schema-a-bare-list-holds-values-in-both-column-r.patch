     it('the Arabic list of values is still refused', () => {
         expect(derivedColumns('متجر بفئات: قهوة، أدوات، حلويات')).toBeNull();
     });
+
+    it('a bare «قائمة» of definite names is still his columns — the list rule is for Latin items only', () => {
+        //  The negative half of «a list holds values»: Arabic answers that
