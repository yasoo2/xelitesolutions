#!/usr/bin/env expect -f

set timeout 60

spawn ssh root@46.224.187.142 "docker --version && docker stop mongodb 2>/dev/null; docker rm mongodb 2>/dev/null; docker run -d --name mongodb --restart always -p 27017:27017 -v mongodb_data:/data/db mongo:7.0 && sleep 3 && docker ps | grep mongodb && docker logs mongodb 2>&1 | tail -10"

expect {
    "password:" {
        send "Younes.sowady2011\r"
        exp_continue
    }
    "Permission denied" {
        puts "Authentication failed"
        exit 1
    }
    eof {
        puts "Command completed"
    }
    timeout {
        puts "Timeout"
        exit 1
    }
}
