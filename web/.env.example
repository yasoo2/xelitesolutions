# متغيرات بيئة الواجهة الأمامية (Web)

# عنوان URL للواجهة الخلفية (API)
# إذا لم يتم تعيينه، فسيتم استخدام http://127.0.0.1:8080 افتراضيًا في التطوير
VITE_API_URL=http://localhost:8080
VITE_FEATURE_BROWSER_CHROME=0

# عنوان URL لخادم WebSocket
# إذا لم يتم تعيينه، فسيتم اشتقاقه من VITE_API_URL
# VITE_WS_URL=ws://localhost:8080/ws
