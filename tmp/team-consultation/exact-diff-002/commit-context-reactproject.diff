 import ts from 'typescript';
+import fs from 'fs';
+import path from 'path';
 
 const cssTree = require('css-tree');
 
+/** Read styles actually imported from index.html's local module entrypoints.
+ * An orphan CSS file or a JavaScript string is not evidence of applied styles.
+ */
+export function readAppliedProjectStylesheets(projectRoot: string): string[] {
+    const styles: string[] = [];
+    const visited = new Set<string>();
+    let bytes = 0;
+    try {
+        const root = fs.realpathSync(projectRoot);
+        const contained = (file: string) => {
+            const relative = path.relative(root, file);
+            return relative !== '..' && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative);
+        };
+        const resolve = (specifier: string, from: string): string | undefined => {
+            if (!specifier.startsWith('.') && !specifier.startsWith('/')) return undefined;
+            const base = specifier.startsWith('/') ? path.join(root, specifier.slice(1)) : path.resolve(path.dirname(from), specifier);
+            if (!contained(base)) return undefined;
+            for (const candidate of [base, ...['.jsx', '.tsx', '.js', '.ts', '/index.jsx', '/index.tsx', '/index.js', '/index.ts'].map(extension => base + extension)]) {
+                if (!fs.existsSync(candidate)) continue;
+                const actual = fs.realpathSync(candidate);
+                if (contained(actual) && fs.statSync(actual).isFile()) return actual;
+            }
+            return undefined;
+        };
+        const visit = (file: string, depth: number) => {
+            if (depth > 16 || visited.size >= 128) throw new Error('style_graph_budget');
+            if (visited.has(file)) return;
+            visited.add(file);
+            const size = fs.statSync(file).size;
+            if (size > 200_000 || bytes + size > 1_000_000) throw new Error('style_graph_bytes');
+            bytes += size;
+            const source = fs.readFileSync(file, 'utf8');
+            if (file.endsWith('.css')) {
+                styles.push(source);
+                const ast = cssTree.parse(source);
+                cssTree.walk(ast, { visit: 'Atrule', enter(node: any) {
+                    if (node.name !== 'import') return;
+                    cssTree.walk(node.prelude, (part: any) => {
+                        if (part.type !== 'String' && part.type !== 'Url') return;
+                        const specifier = String(part.value);
+                        const target = resolve(specifier.startsWith('.') || specifier.startsWith('/') ? specifier : `./${specifier}`, file);
+                        if (target) visit(target, depth + 1);
+                    });
+                } });
+                return;
+            }
+            const tree = ts.createSourceFile(file, source, ts.ScriptTarget.Latest, true, ts.ScriptKind.TSX);
+            for (const statement of tree.statements) {
+                if (!ts.isImportDeclaration(statement) && !ts.isExportDeclaration(statement)) continue;
+                if (!statement.moduleSpecifier || !ts.isStringLiteral(statement.moduleSpecifier)) continue;
+                if (ts.isImportDeclaration(statement) && statement.importClause?.isTypeOnly) continue;
+                if (ts.isImportDeclaration(statement) && statement.importClause?.namedBindings
+                    && ts.isNamedImports(statement.importClause.namedBindings)
+                    && !statement.importClause.name
+                    && statement.importClause.namedBindings.elements.length > 0
+                    && statement.importClause.namedBindings.elements.every(element => element.isTypeOnly)) continue;
+                if (ts.isExportDeclaration(statement) && statement.isTypeOnly) continue;
+                if (ts.isExportDeclaration(statement) && statement.exportClause && ts.isNamedExports(statement.exportClause)
+                    && statement.exportClause.elements.length > 0
+                    && statement.exportClause.elements.every(element => element.isTypeOnly)) continue;
+                const target = resolve(statement.moduleSpecifier.text, file);
+                if (target) visit(target, depth + 1);
+            }
+        };
+        const index = path.join(root, 'index.html');
+        if (!contained(fs.realpathSync(index)) || fs.statSync(index).size > 32_768) return [];
+        const html = fs.readFileSync(index, 'utf8').replace(/<!--[\s\S]*?-->/g, '');
+        for (const match of html.matchAll(/<script\b([^>]*)>/gi)) {
+            if (!/\btype\s*=\s*['"]module['"]/i.test(match[1])) continue;
+            const specifier = match[1].match(/\bsrc\s*=\s*['"]([^'"]+)['"]/i)?.[1];
+            if (!specifier) continue;
+            const target = resolve(specifier.startsWith('/') || specifier.startsWith('.') ? specifier : `./${specifier}`, index);
+            if (target) visit(target, 0);
+        }
+        return styles;
+    } catch {
+        return []; // Incomplete provenance must not become a style PASS.
+    }
+}
