# متغيرات بيئة الخادم الخلفي (API)

# المنفذ الذي سيعمل عليه الخادم
PORT=8080

# عنوان URI للاتصال بقاعدة بيانات MongoDB
MONGO_URI=mongodb://localhost:27017/joe

# مفتاح سري لتوقيع رموز JWT (يجب تغييره في بيئة الإنتاج)
JWT_SECRET=change-me-in-production

# قائمة الأصول المسموح بها للاتصال بالواجهة الخلفية (مفصولة بفاصلة)
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# عنوان URL لعامل المتصفح (إذا كنت تستخدمه)
BROWSER_WORKER_URL=http://127.0.0.1:7070

# مفتاح المصادقة لعامل المتصفح (يجب تغييره)
BROWSER_WORKER_KEY=change-me

# المجلد لتخزين الملفات المؤقتة والتحف
ARTIFACT_DIR=/tmp/joe-artifacts

# بيئة التشغيل (development أو production)
NODE_ENV=development

# استخدم قاعدة بيانات وهمية بدلاً من MongoDB (1 = نعم، 0 = لا)
MOCK_DB=0

# السماح بتسجيل مستخدمين جدد (true أو false)
REGISTRATION_OPEN=true

# البريد الإلكتروني للمسؤول (لإنشاء حساب مسؤول تلقائيًا)
ADMIN_EMAIL=admin@example.com

# كلمة مرور المسؤول (لإنشاء حساب مسؤول تلقائيًا)
ADMIN_PASSWORD=admin

# تفعيل تجاوز المصادقة في بيئة التطوير (true أو false)
# تحذير: لا تستخدم هذا في بيئة الإنتاج!
ENABLE_AUTH_BYPASS=true
