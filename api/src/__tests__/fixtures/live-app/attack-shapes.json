 "vite-middleware-writes": {
  "data/orders.ndjson": "{\"real\":\"order\"}\n",
  "index.html": "<script type=module src=/src/main.js></script>",
  "package.json": "{\n \"scripts\": {\n  \"dev\": \"vite\"\n },\n \"devDependencies\": {\n  \"vite\": \"^6\"\n }\n}",
  "vite.config.js": "import fs from 'fs';\nexport default { plugins: [{ name: 'api', configureServer(s) { s.middlewares.use('/api/orders', (q, r) => { let b=''; q.on('data', x => b += x); q.on('end', () => { fs.appendFileSync('data/orders.ndjson', b + '\\n'); r.end('ok'); }); }); } }] };"
 },
