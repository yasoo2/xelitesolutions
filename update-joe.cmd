@echo off
chcp 65001 >nul
REM ============================================================
REM  update-joe.cmd — انقر نقرتين. لا شيء تكتبه.
REM
REM  «بدي طريقة ما احطها ولا مرة» — هذه هي: ملف تنقر عليه نقراً
REM  مزدوجاً من داخل مجلد المشروع فيقوم بكل شيء.
REM
REM  ولماذا ملف .cmd وليس .ps1 مباشرة؟ لأن سياسة تنفيذ السكربتات
REM  عندك تمنع تشغيل ملفات PowerShell غير الموقّعة، وهذا الملف يمرّر
REM  -ExecutionPolicy Bypass لهذه الجلسة وحدها، فلا تُغيّر إعدادات
REM  جهازك ولا تُضعف حمايته.
REM ============================================================
cd /d "%~dp0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0update-joe.ps1"
if errorlevel 1 (
  echo.
  echo [X] انتهى التحديث بخطأ. اقرأ الرسائل أعلاه.
  pause
)
