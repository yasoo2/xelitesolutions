# System Configuration
NODE_ENV=production
PORT=3000
JWT_SECRET=replace_with_secure_random_string

# MongoDB Configuration
MONGO_URI=mongodb://mongo:27017/joe

# ============================================================================
# SELF-HOSTED / OFFLINE (single-user) MODE
# ----------------------------------------------------------------------------
# Run Joe on one machine without MongoDB or multi-tenant auth:
#   MOCK_DB=1               # skip MongoDB; persist to api/data/db as JSON
#   ENABLE_AUTH_BYPASS=true # single-user mode: tools run without a per-request
#                           # logged-in user/workspace (do NOT enable on a shared
#                           # or public server — it disables tenant isolation)
#   AUTO_APPROVE_ALL=1      # auto-approve tool actions (no manual approval prompts)
#   AUTO_APPROVE_SAFE=1     # auto-approve only low-risk tool actions
# ============================================================================

# Browser Worker Configuration
BROWSER_WS_ENDPOINT=ws://browser-worker:5050/ws
WORKER_API_KEY=joe_secret_browser_key

# ============================================================================
# AI PROVIDERS  (Joe runs on FREE intelligence — NO API KEY REQUIRED)
# ----------------------------------------------------------------------------
# Joe works out-of-the-box with ZERO keys via keyless public gateways
# (LLM7 + Pollinations). Leave everything below empty and Joe still runs.
#
# NOTE: keyless gateways are blocked on some restricted/cloud networks but
# work on a normal local machine. Adding a free key (optional) makes Joe
# faster and more reliable, but is never required.
#
# Keyless brain (no key, no signup) — used automatically when no keys are set:
#   LLM7_MODEL=gpt-4o-mini            # optional model override
#   LLM7_BASE_URL=https://api.llm7.io/v1
#   LLM7_DISABLE=0                    # set 1 to turn the keyless gateway off
#
# ----------------------------------------------------------------------------
# OPTIONAL free keys (make Joe faster/more reliable, but NOT required).
# The router is "free-first": it tries the strongest FREE providers first and
# only falls back to paid ones. ONE key is more than enough. Start with Gemini.
#
# The router tries them in this order (each is skipped if its key is empty):
#
#   1) Gemini    — STRONGEST free model. 1500 req/day, 1M context, no card.
#                  Get a free key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
#                  (GEMINI_API_KEY is accepted as an alias)
GEMINI_API_KEY=
#
#   2) Groq      — FASTEST free inference (Llama 3.3 70B). No credit card.
#                  Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
#
#   3) Cerebras  — ~1M free tokens/day, ultra-fast.
#                  Get a free key: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
#
#   4) OpenRouter— ONE key unlocks ~30 free models.
#                  Get a free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
#
#   5) Mistral   — ~1B free tokens/month, strong multilingual + code.
#                  Get a free key: https://console.mistral.ai/
MISTRAL_API_KEY=
#
#   6) HuggingFace — free open-model inference.
#                  Get a free token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
#
# Optional force / self-hosted:
#   LLM_PROVIDER=pollinations        # force keyless proxy
#   LOCAL_LLM_BASE_URL=http://localhost:11434/v1   # Ollama / LM Studio
#   LOCAL_LLM_MODEL=llama3.1
# ============================================================================

# PAID providers (deep fallback only — optional)
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=...

# Registration
REGISTRATION_OPEN=true
ADMIN_EMAIL=admin@xelitesolutions.com
ADMIN_PASSWORD=change_me_on_first_login

# Deployment Path
DEPLOY_PATH=/opt/joe
