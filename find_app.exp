#!/usr/bin/expect

set timeout 30
set host "46.224.187.142"
set user "root"
set password "Younes.sowady2011"

spawn ssh -o StrictHostKeyChecking=no $user@$host

expect {
    "password:" { send "$password\r" }
    "yes/no" { send "yes\r"; exp_continue }
}

expect "#"
send "find / -name docker-compose.production.yml 2>/dev/null | head -n 1\r"

expect "#"
send "ls -la\r"

expect "#"
send "exit\r"

expect eof
