{
  "manifest_version": 3,
  "name": "Joe Browser Connector",
  "version": "1.0.0",
  "description": "يربط متصفحك الحقيقي بحساباتك مع نظام جو، ليتصرّف جو في متصفحك بأمان بعد موافقتك.",
  "permissions": ["tabs", "scripting", "activeTab", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Joe Browser Connector" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5002/*",
        "http://127.0.0.1:5002/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
