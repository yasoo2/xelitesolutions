{
  "name": "xelitesolutions",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build:api": "npm --prefix api run build",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:api && npm run build:web && node -e \"const fs=require('fs'); if(fs.existsSync('web/dist')) { fs.cpSync('web/dist', 'dist', {recursive: true}); }\"",
    "postinstall": "npm --prefix api install --no-audit --no-fund --include=dev --legacy-peer-deps && npm --prefix web install --no-audit --no-fund --include=dev --legacy-peer-deps",
    "prestart": "npm --prefix api run build",
    "start": "npm --prefix api run start"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vitejs/plugin-react": "^6.0.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
