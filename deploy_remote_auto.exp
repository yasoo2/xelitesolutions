#!/usr/bin/expect

set timeout 300
set host "46.224.187.142"
set user "root"
set password "Younes.sowady2011"

spawn ssh -o StrictHostKeyChecking=no $user@$host

expect {
    "password:" { send "$password\r" }
    "yes/no" { send "yes\r"; exp_continue }
}

expect "#"
send "cd /root/xelitesolutions && git pull origin main\r"

expect "#"
send "bash update_prod.sh\r"

expect "#"
send "docker compose -f docker-compose.production.yml exec mongo mongosh joe --eval 'db.sessions.deleteMany({}); db.messages.deleteMany({});'\r"

expect "#"
send "exit\r"

expect eof
