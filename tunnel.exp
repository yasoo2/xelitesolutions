#!/usr/bin/env expect -f

set timeout -1
log_user 1

spawn ssh -o StrictHostKeyChecking=no -L 27017:localhost:27017 -N root@46.224.187.142

expect {
    "password:" {
        send "Younes.sowady2011\r"
        expect {
            "Permission denied" {
                puts "Authentication failed"
                exit 1
            }
            timeout {
                # Tunnel is established and running
                interact
            }
        }
    }
    timeout {
        puts "Timeout waiting for password prompt"
        exit 1
    }
}
